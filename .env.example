VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_AUTH_TOKEN_HEADER=x-maylove-token
VITE_STORAGE_UPLOAD_URL=http://localhost:8081/api/v1

# Dados mockados (MSW): true roda o app sem backend. Deixe vazio/false para usar a API real.
VITE_USE_MOCKS=false

# Quando false, o app esconde checkout e publica direto (deve combinar com BILLING_ENABLED=false na API).
VITE_BILLING_ENABLED=false
